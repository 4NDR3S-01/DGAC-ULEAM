#!/usr/bin/env bash
# Plantilla: cp detener.sh.example detener.sh && chmod +x detener.sh

port_open() {
  timeout 1 bash -c "echo >/dev/tcp/127.0.0.1/$1" 2>/dev/null
}

echo "▶ Deteniendo servidor PHP (puerto 8000)..."
if port_open 8000; then
  fuser -k 8000/tcp >/dev/null 2>&1 || true
  pkill -f "php -S 127.0.0.1:8000" >/dev/null 2>&1 || true
  echo "✔ Servidor PHP detenido."
else
  echo "  (no estaba corriendo)"
fi

echo "▶ Deteniendo MariaDB (puerto 3307)..."
if command -v docker >/dev/null 2>&1 && docker ps --format '{{.Names}}' 2>/dev/null | grep -qx 'uleam-mariadb'; then
  docker stop uleam-mariadb >/dev/null
  echo "✔ MariaDB (Docker) detenida."
elif [ -S "$HOME/local-mariadb/mysql.sock" ]; then
  mariadb-admin --socket="$HOME/local-mariadb/mysql.sock" -u root shutdown >/dev/null 2>&1 || true
  sleep 1
  fuser -k 3307/tcp >/dev/null 2>&1 || true
  echo "✔ MariaDB local detenida."
elif port_open 3307; then
  fuser -k 3307/tcp >/dev/null 2>&1 || true
  echo "✔ Proceso en puerto 3307 detenido."
else
  echo "  (no estaba corriendo)"
fi
