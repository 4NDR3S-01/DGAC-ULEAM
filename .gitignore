
# Logs / temporales
*.log
/tmp/

# Entorno local
.env
.env.*
!.env.example

# wp-config.php
/wordpress/wp-config.php
# Archivos subidos a WordPress (pesan GB; se suben directo al hosting)
/wordpress/wp-content/uploads/

# Respaldos y exportaciones de base de datos locales
/respaldo-*.sql
/spam-eliminado-*.tsv
/paginas-antes-de-papelera-*.csv

# Scripts de un solo uso de la migración
/fix_post_types.sh
/importar_datos.sh

# Importador de WordPress (solo se usó para la migración)
/wordpress/wp-content/plugins/wordpress-importer/
/wordpress/wp-content/languages/plugins/wordpress-importer-*

# Caché del rastreo del sitio oficial (12 MB, solo para regenerar datos)
/.migracion-oficial/
/archivos-faltantes.txt

# Respaldo local del contenido del sitio oficial
/respaldo-sitio-oficial-*/

# Paquete de despliegue generado (volcados con datos, uploads copiados)
/dist/
