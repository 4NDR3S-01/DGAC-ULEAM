// ** Base de datos ** //
define( 'DB_NAME', '<base-de-datos>' );
define( 'DB_USER', '<usuario>' );
define( 'DB_PASSWORD', '<clave>' );
define( 'DB_HOST', '<host-de-la-base>' );
define( 'DB_CHARSET', 'utf8mb4' );
define( 'DB_COLLATE', '' );

// ** Dirección fija del sitio (no se toma del host de cada petición) ** //
define( 'WP_HOME', 'https://dgacweb.uleam.edu.ec' );
define( 'WP_SITEURL', 'https://dgacweb.uleam.edu.ec' );
define( 'FORCE_SSL_ADMIN', true );

// ** Claves y salts: generar nuevas en https://api.wordpress.org/secret-key/1.1/salt/ ** //
define( 'AUTH_KEY', '<generar>' );
define( 'SECURE_AUTH_KEY', '<generar>' );
define( 'LOGGED_IN_KEY', '<generar>' );
define( 'NONCE_KEY', '<generar>' );
define( 'AUTH_SALT', '<generar>' );
define( 'SECURE_AUTH_SALT', '<generar>' );
define( 'LOGGED_IN_SALT', '<generar>' );
define( 'NONCE_SALT', '<generar>' );
define( 'WP_CACHE_KEY_SALT', '<generar>' );

$table_prefix = 'wp_';

// ** Seguridad y depuración ** //
define( 'WP_DEBUG', false );
define( 'WP_DEBUG_DISPLAY', false );
define( 'WP_DEBUG_LOG', false );
define( 'DISALLOW_FILE_EDIT', true );
// define( 'DISALLOW_FILE_MODS', true ); // Descomentar si las actualizaciones las hace TI por línea de comandos.
define( 'WP_AUTO_UPDATE_CORE', 'minor' );

