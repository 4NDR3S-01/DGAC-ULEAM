<?php
/**
 * Plantilla de wp-config.php para DESARROLLO LOCAL.
 * Cópiala a wordpress/wp-config.php (ignorado por git) y rellena tus datos.
 * Para producción usa wp-config.produccion.php.example.
 */

define( 'DB_NAME',     '<tu-base>' );
define( 'DB_USER',     '<tu-usuario>' );
define( 'DB_PASSWORD', '<tu-clave>' );
define( 'DB_HOST',     '127.0.0.1:3306' );   // host:puerto de TU MariaDB/MySQL
define( 'DB_CHARSET',  'utf8mb4' );
define( 'DB_COLLATE',  '' );

// Debe coincidir con el prefijo de tu base (revisa las tablas: wp_posts, ...).
$table_prefix = 'wp_';

// Fuerza la URL local aunque la base guarde la de producción.
define( 'WP_HOME',    'http://localhost:8000' );
define( 'WP_SITEURL', 'http://localhost:8000' );

// Genera claves en https://api.wordpress.org/secret-key/1.1/salt/
define( 'AUTH_KEY',         '<generar>' );
define( 'SECURE_AUTH_KEY',  '<generar>' );
define( 'LOGGED_IN_KEY',    '<generar>' );
define( 'NONCE_KEY',        '<generar>' );
define( 'AUTH_SALT',        '<generar>' );
define( 'SECURE_AUTH_SALT', '<generar>' );
define( 'LOGGED_IN_SALT',   '<generar>' );
define( 'NONCE_SALT',       '<generar>' );

define( 'WP_DEBUG', true );
define( 'WP_DEBUG_DISPLAY', true );
define( 'WP_DEBUG_LOG', false );

if ( ! defined( 'ABSPATH' ) ) {
	define( 'ABSPATH', __DIR__ . '/' );
}

require_once ABSPATH . 'wp-settings.php';
