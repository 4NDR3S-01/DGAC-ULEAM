# Renombrar a ".htaccess" y colocarlo DENTRO de la carpeta gestion-aseguramiento-calidad/
# (junto a wp-config.php). Es el estándar de WordPress para un sitio en subcarpeta.
# Las direcciones viejas (/files/…, procedimientos, noticias con fecha) las resuelve WordPress:
# no hace falta agregar reglas aquí.

# No ejecutar PHP dentro de uploads (el sitio anterior fue hackeado por ahí).
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^wp-content/uploads/.*\.(php|phtml|phar)$ - [F,L,NC]
</IfModule>

# BEGIN WordPress
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /gestion-aseguramiento-calidad/
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /gestion-aseguramiento-calidad/index.php [L]
</IfModule>
# END WordPress

# No listar carpetas ni servir archivos sensibles.
Options -Indexes
<FilesMatch "^(wp-config\.php|readme\.html|license\.txt|.*\.(sql|sql\.gz|log|deb))$">
	Require all denied
</FilesMatch>
